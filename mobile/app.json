{
  "expo": {
    "name": "Millennia FieldOps",
    "slug": "millennia-fieldops",
    "version": "2.1.0",
    "orientation": "portrait",
    "scheme": "millenniafieldops",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/51abb8a6-6521-42ba-b27e-a421b6f72b92",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Millennia FieldOps uses the camera to photograph field observations.",
        "NSLocationWhenInUseUsageDescription": "Millennia FieldOps records the GPS location of each observation.",
        "NSPhotoLibraryUsageDescription": "Millennia FieldOps attaches photos from your library to records."
      }
    },
    "android": {
      "package": "my.millennia.fieldops",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D2F24"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Millennia FieldOps attaches photos from your library to records.",
          "cameraPermission": "Millennia FieldOps uses the camera to photograph field observations."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Millennia FieldOps records the GPS location of each observation."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D2F24",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "51abb8a6-6521-42ba-b27e-a421b6f72b92"
      }
    },
    "owner": "yezawtun_afk"
  }
}
