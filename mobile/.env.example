# Copy this file to .env and paste your Supabase values.
# Find them in Supabase: Project Settings -> API.
#
# Expo only exposes variables that start with EXPO_PUBLIC_ to the app.
# The anon key slot also accepts the newer publishable key (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional. Phone sign-in asks the web dashboard to resolve the number; this is
# that dashboard's address. Defaults to the deployed demo site when unset.
EXPO_PUBLIC_WEB_URL=https://millennia-fieldops-rewrite.vercel.app

# None of the AI photo assist settings belong in this file. The Google key is a
# Supabase secret for the analyze-record Edge Function, so it never ships in the
# app bundle: set GOOGLE_AI_STUDIO_KEY (and optionally GEMINI_MODEL) with
#   npx supabase secrets set GOOGLE_AI_STUDIO_KEY=your-key-here --project-ref <ref>
# See docs/DEPLOY.md ("AI photo assist") and
# supabase/functions/analyze-record/README.md.
