# Copy this file to .env and paste your Supabase values.
# Find them in Supabase: Project Settings -> API.
#
# Expo only exposes variables that start with EXPO_PUBLIC_ to the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional. Phone sign-in asks the web dashboard to resolve the number; this is
# that dashboard's address. Defaults to the deployed demo site when unset.
EXPO_PUBLIC_WEB_URL=https://millennia-fieldops-rewrite.vercel.app
