# Secrets
.env
.env.local
.env.*.local

# Dependencies
# NOTE: keep these directory patterns free of a trailing slash. During
# `eas build`, EAS CLI filters the upload with the `ignore` npm package, which
# does not match a path like "web/.next" against a directory-only pattern
# ("web/.next/"). A non-matching rule means EAS tries to copy the folder into
# its temp workspace, and a junction there fails on Windows with
# "EPERM: operation not permitted, symlink ...". Plain patterns still work
# with git, which is why they are written this way.
node_modules

# Next.js
web/.next
web/out
web/next-env.d.ts
*.tsbuildinfo

# Expo / React Native
mobile/.expo
mobile/.expo-shared
mobile/dist
mobile/web-build
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Supabase CLI
supabase/.temp
supabase/.branches

# Generated: combined SQL script for the Supabase SQL Editor
# (rebuild with tools\bundle-db-sql.ps1)
supabase/setup_all.sql

# Generated design-review output (screenshots + report from the taste skill)
.taste/

# Local AI-assistant tooling (skills installed with `npx skills add`).
# Delete these lines if you want to share the skills with the repo.
.agents/
agent/skills/
.claude/
.taste-skill/
skills-lock.json

# Logs, OS and editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
