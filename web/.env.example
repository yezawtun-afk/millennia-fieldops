# Copy this file to .env.local and paste your Supabase values.
# Find the first two in Supabase: Project Settings -> API.
#
# The anon key slot also accepts the newer publishable key (sb_publishable_...);
# both are safe to expose in the browser. Never put the service_role secret in a
# NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Project Settings -> API -> service_role secret.
# SERVER ONLY. Needed for an admin to create new accounts from the Users page,
# and by /api/auth/login to resolve a phone number to its account. Without it
# those two features return a clear "not configured" error; everything else works.
# Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# No AI settings belong here. The mobile app's AI photo assist calls the
# analyze-record Supabase Edge Function, and its Google key is a Supabase secret
# (GOOGLE_AI_STUDIO_KEY, optionally GEMINI_MODEL). See docs/DEPLOY.md
# ("AI photo assist") and supabase/functions/analyze-record/README.md.
