# Copy this file to .env.local and paste your Supabase values.
# Find the first two in Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Project Settings -> API -> service_role secret.
# SERVER ONLY. Needed for an admin to create new accounts from the Users page.
# Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
